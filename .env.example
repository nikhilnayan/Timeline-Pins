# Firebase Web App Configuration
# Copy this file to .env and fill in values from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Google Maps API key (Maps JS API + Geocoding API enabled) for fast place naming
# If omitted, the app falls back to OpenStreetMap Nominatim (1 req/sec)
VITE_GOOGLE_MAPS_API_KEY=
