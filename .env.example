# Clerk Publishable Key (required for Sign in with Google via Clerk)
# Get this from Clerk Dashboard > Configure > API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# Optional: Google Maps API key (Maps JS API + Geocoding API enabled) for fast place naming
# If omitted, the app falls back to OpenStreetMap Nominatim (1 req/sec).
VITE_GOOGLE_MAPS_API_KEY=
